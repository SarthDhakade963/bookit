// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Experience {
  id          String      @id @default(uuid())
  title       String
  slug        String   @unique
  description String?
  location    String?
  priceCents  Int
  imageUrl    String?
  durationMin Int?
  createdAt   DateTime @default(now())

  dates       Slot[]
  bookings    Booking[]
}

model Slot { // Date Slot
  id            String      @id @default(uuid())
  experienceId  String
  experience    Experience @relation(fields: [experienceId], references: [id])

  date          DateTime 
  createdAt     DateTime @default(now())

  times         SlotAvailability[]
  bookings      Booking[]
}

model SlotAvailability { // Time Slot
  id       String      @id @default(uuid())
  slotId   String
  slot     Slot @relation(fields: [slotId], references: [id])

  time     String       
  capacity Int @default(8)
  bookings  Booking[]

  @@unique([slotId, time])  
}

model Booking {
  id              String      @id @default(uuid())
  experienceId    String
  experience      Experience @relation(fields: [experienceId], references: [id])

  slotId          String
  slot            Slot @relation(fields: [slotId], references: [id])

  slotTimeId      String      
  slotTime        SlotAvailability @relation(fields: [slotTimeId], references: [id])
  
  date            DateTime
  userName        String
  userEmail       String
  seats           Int
  promoCode       String?
  totalPriceCents Int

  status          BookingStatus @default(PENDING)
  createdAt       DateTime @default(now())
}

enum BookingStatus {
  CONFIRMED
  PENDING
  FAILED
}
